# Eco-Loop Building Agents - Environment Configuration
# Copy this file to .env and adjust paths for your system.

# Path to EnergyPlus installation folder (e.g., C:\EnergyPlusV23-2-0 or /usr/local/EnergyPlus-23-2-0)
ENERGYPLUS_HOME=

# Optional: Direct path to energyplus executable if not under ENERGYPLUS_HOME
ENERGYPLUS_EXECUTABLE=

# Optional: Direct path to pyenergyplus module directory if outside standard location
ENERGYPLUS_PYTHON_API_PATH=

# Paths to building model and weather file (relative to project root or absolute)
BASELINE_IDF=models/baseline/baseline.idf
WEATHER_FILE=weather/weather.epw

# Output directory for simulation artifacts
OUTPUT_DIRECTORY=outputs
